{
  "name": "tiny-batch",
  "version": "0.0.1",
  "description": "Tiny batching utility for concurrent async operations",
  "keywords": [
    "async",
    "batch",
    "concurrency",
    "tiny"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/batch.cjs",
  "module": "./dist/batch.js",
  "types": "./dist/batch.d.cts",
  "exports": {
    ".": {
      "types": "./dist/batch.d.cts",
      "import": "./dist/batch.js",
      "require": "./dist/batch.cjs"
    }
  },
  "scripts": {
    "build": "tsc",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "test": "vitest run --reporter=dot",
    "test:watch": "vitest --reporter=dot",
    "test:cov": "vitest run --coverage --reporter=dot"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.11",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.22.0"
}
